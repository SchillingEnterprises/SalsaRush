# Export these environment variables in your shell/deployment environment.
# Generate a fresh key with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# The application requires at least 50 characters and at least 5 distinct characters.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=/absolute/path/to/local.sqlite3
# Production: DEBUG=false, set production hosts/origins and secure cookie/HTTPS settings.
# Enable HSTS for subdomains only when every subdomain supports HTTPS.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false

# Production PostgreSQL / managed database configuration.
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=salsa_rush
# DJANGO_DB_USER=salsa_rush_app
# DJANGO_DB_PASSWORD=load-from-secret-manager
# DJANGO_DB_HOST=your-managed-postgres-host
# DJANGO_DB_PORT=5432
# DJANGO_DB_SSLMODE=verify-full
# DJANGO_DB_SSLROOTCERT=/path/to/provider-ca.pem
# DJANGO_DB_CONN_MAX_AGE=60
